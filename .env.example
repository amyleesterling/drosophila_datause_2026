# Copy to .env and fill in. The pipeline reads these via python-dotenv.

# Required for Unpaywall API (their terms require a contact email).
UNPAYWALL_EMAIL=your_email@example.com

# Polite-pool contact for OpenAlex / Crossref (recommended, not required).
OPENALEX_MAILTO=your_email@example.com
CROSSREF_MAILTO=your_email@example.com

# Optional: raises Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=

# NCBI E-utilities (PubMed). Email recommended; key raises rate limits.
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=

# LLM classification. Provide ONE of the following. The classifier
# auto-detects which provider to use (Anthropic preferred if both set).
# Without any key the pipeline runs rules-only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
