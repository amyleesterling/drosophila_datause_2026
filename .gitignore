__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Caches and large artifacts are reproducible; don't commit them.
data/cache/metadata/*
data/cache/full_text/*
data/cache/pdfs/*
data/cache/parsed_text/*
data/cache/classifier/*
data/cache/*.parquet
!data/cache/**/.gitkeep

# Local input exports of the Google Sheet (may be private).
data/input/*.xlsx
data/input/*.csv
!data/input/.gitkeep

# Generated outputs (regenerated by the pipeline).
outputs/*
!outputs/.gitkeep

.pytest_cache/
.DS_Store
